rules_version = '2';

// Regras de segurança do Firestore da loja.
//
// - O bot grava com credenciais de administrador (service account), que ignoram estas regras.
// - O painel web (pasta dashboard/) lê pelo navegador, então precisa destas regras:
//   só entra quem fez login com uma conta Google de e-mail verificado que esteja na
//   coleção `loja_staff` (gerida pelo comando `buggy!loja_acesso` no Discord).
// - Ninguém escreve pelo navegador.
service cloud.firestore {
  match /databases/{database}/documents {

    function eStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/loja_staff/$(request.auth.token.email.lower()));
    }

    match /loja_pedidos/{id} {
      allow read: if eStaff();
      allow write: if false;
    }

    match /loja_meta/{id} {
      allow read: if eStaff();
      allow write: if false;
    }

    // Todo o resto (inclusive loja_staff) fica fechado para o navegador.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
